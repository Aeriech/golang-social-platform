migrations

migrate create -ext sql -dir ./cmd/migrate/migrations -seq create_table_names_table
migrate -database="postgres://user:password@localhost:5432/social?sslmode=disable" --path=./cmd/migrate/migrations up
migrate -database="postgres://user:password@localhost:5432/social?sslmode=disable" --path=./cmd/migrate/migrations down
migrate -database="postgres://user:password@localhost:5432/social?sslmode=disable" --path=./cmd/migrate/migrations force Version